{
  "config": {
    "flow_title": "Envoy {serial}",
    "step": {
      "user": {
        "title": "Enphase IQ Gateway",
        "description": "The gateway is read directly on your own network; no cloud is used for the measurements.",
        "data": {
          "host": "Host"
        },
        "data_description": {
          "host": "IP address or host name of the IQ Gateway, e.g. 192.168.1.50"
        }
      },
      "auth": {
        "title": "Sign in for gateway {serial}",
        "description": "Firmware {firmware} needs a token. Enter your Enlighten e-mail and password (the token is then fetched and renewed automatically), or paste a token from entrez.enphaseenergy.com.",
        "data": {
          "username": "Enlighten e-mail",
          "password": "Enlighten password",
          "token": "Token (optional, instead of e-mail/password)"
        }
      },
      "reauth_confirm": {
        "title": "Sign in again",
        "description": "The token for gateway {serial} no longer works. Enter your Enlighten e-mail and password or a new token.",
        "data": {
          "username": "Enlighten e-mail",
          "password": "Enlighten password",
          "token": "Token (optional, instead of e-mail/password)"
        }
      },
      "reconfigure": {
        "title": "Change address",
        "data": {
          "host": "Host"
        },
        "data_description": {
          "host": "IP address or host name of the IQ Gateway, e.g. 192.168.1.50"
        }
      }
    },
    "error": {
      "cannot_connect": "Cannot reach the gateway on this address.",
      "not_an_envoy": "This address does not answer like an Enphase IQ Gateway.",
      "no_credentials": "Enter an e-mail and password, or a token.",
      "invalid_auth": "Enlighten rejected the e-mail or password.",
      "mfa_enabled": "This Enlighten account uses two-factor authentication. Paste a token instead.",
      "not_owner": "Enphase issued no token for this gateway. Is it linked to this Enlighten account?",
      "enlighten_unavailable": "Enlighten is not reachable right now. Try again later or paste a token.",
      "invalid_token": "This is not a valid token.",
      "token_rejected": "The gateway rejected the token.",
      "unknown": "Unexpected error, see the log."
    },
    "abort": {
      "already_configured": "This gateway is already set up.",
      "reauth_successful": "Signed in again.",
      "reconfigure_successful": "Address changed.",
      "wrong_device": "That address belongs to a different gateway.",
      "not_ipv4_address": "Only IPv4 addresses are supported.",
      "cannot_connect": "Cannot reach the gateway."
    }
  },
