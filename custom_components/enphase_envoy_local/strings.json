  "issues": {
    "inverter_underperforming": {
      "title": "Panel {serial} produces less than its neighbours",
      "description": "Microinverter {serial} ({where}) produced {performance}% of the median of the other panels on the same roof surface. Check for shade, dirt or damage. This notice disappears by itself when it recovers."
    },
    "inverter_no_output": {
      "title": "Panel {serial} produces nothing",
      "description": "Microinverter {serial} ({where}) has given no output for more than 30 minutes while the other panels on the same roof surface are producing. Check the inverter, its connector and the panel."
    },
    "cloud_offline": {
      "title": "Gateway {serial} has no connection with Enlighten",
      "description": "The gateway has not reported to Enlighten for more than 6 hours. Local readings keep working, but Enlighten and firmware updates do not. Check its network connection."
    }
